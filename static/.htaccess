# Trullo Rosy - sito statico (generato da build.py, repo vitosemeraro/trullo-rosy-sito)
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# https e senza www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://trullo-rosy.it/$1 [R=301,L]

# Vecchie pagine WordPress -> pagine nuove (301)
RewriteRule ^contact-trullo-rosy/?$ /en/contact/ [R=301,L]
RewriteRule ^contact-us-old/?$ /en/contact/ [R=301,L]
RewriteRule ^gallery-2/?$ /en/gallery/ [R=301,L]
RewriteRule ^comfort-and-charm-at-trullo-rosy/?$ /en/the-trullo/ [R=301,L]
RewriteRule ^accommodation/.*$ /en/the-trullo/ [R=301,L]
RewriteRule ^accommodations/?$ /en/the-trullo/ [R=301,L]
RewriteRule ^accommodation-facility/.*$ /en/the-trullo/ [R=301,L]
RewriteRule ^search-availability/?$ /en/contact/ [R=301,L]
RewriteRule ^home/?.*$ /en/ [R=301,L]

# Pagine demo del tema WordPress: rimosse (410)
RewriteRule ^(2020|2025)/[0-9]{2}/[0-9]{2}/ - [G,L]
RewriteRule ^(sample-page|sample-page-2|typography|blog|restaurant-bar|accommodations-default|search-results)/?$ - [G,L]
RewriteRule ^booking-confirmation(/.*)?$ - [G,L]
RewriteRule ^(services|category|author|tag|mphb_room_type|mphb_room_service)/.*$ - [G,L]
RewriteRule ^(feed|comments/feed)/?$ - [G,L]
RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(webp|png|css|js)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
